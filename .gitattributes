# Keep generated/binary-style artifacts out of GitHub's inline diff view.
*.svg -diff
*.seq -diff
*.mat -diff
KomaMRIPlots/src/ui/*.bundled.js linguist-generated=true

# Pulseq signatures hash exact file bytes, so test fixtures must keep LF endings.
KomaMRIFiles/test/test_files/pulseq/**/*.seq text eol=lf -diff
