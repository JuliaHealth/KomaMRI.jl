# Format of blocks:
# NUM DUR RF  GX  GY  GZ  ADC  EXT
[BLOCKS]
1 412   1   0   0   1  0  0
2  44   0   0   0   2  0  0
3 200   0   0   0   3  0  0
4 524   0   0   0   4  1  1

# Format of RF events:
# id amp mag_id phase_id time_id center delay freq_ppm phase_ppm freq_off phase_off use
# ..  Hz     ..       ..       ..    us    us      ppm   rad/MHz       Hz       rad  ..
# Field 'use' is the initial of:
# excitation refocusing inversion saturation preparation other undefined
[RF]
1 166.405132253 1 2 0 2000 100 0 0 0 0 e

# Format of trapezoid gradient events:
# id      amp      rise  flat  fall  delay
# ..     Hz/m        us    us    us     us
[TRAP]
 1 400000  20 4000  20  80
 2 -2512500 120  200 120   0
 3 -1692708.33333  80 1840  80   0
 4 1250000  60 5120  60   0

# Format of ADC events:
# id  num  dwell  delay  freq_ppm  phase_ppm  freq  phase  phase_id
# ..   ..     ns     us       ppm        ppm    Hz    rad        ..
[ADC]
1 256 20000 60 0 0 0 0 0

# Format of extension events:
# id  type  ref  next_id
# Extension list is followed by extension specifications
[EXTENSIONS]
1 1 1 0

# Extension specification for setting labels:
# id set labelstring
extension LABELSET 1
1 0 SLC

